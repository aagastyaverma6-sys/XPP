{
  "name": "xpp-lang",
  "displayName": "X++ Language Support",
  "description": "Syntax highlighting for X++ (.xp) files – v0.4.7 native VM + package manager + stdlib + strict + AI",
  "version": "0.4.7",
  "publisher": "atom-software",
  "engines": {
    "vscode": "^1.50.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "xpp",
        "aliases": [
          "X++",
          "xpp"
        ],
        "extensions": [
          ".xp"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "xpp",
        "scopeName": "source.xpp",
        "path": "./xp.tmLanguage.json"
      }
    ]
  },
  "icon": "icons/xpp-logo-256.png"
}
