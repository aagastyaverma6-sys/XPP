RNM = XITR
use os
use time
use TerminX

out TerminX.banner("X++ System Health", "cyan")
out TerminX.bold("Node ID: ") + "alpha-node-01"
out TerminX.bold("Workdir: ") + os.getcwd()
out TerminX.bold("Uptime : ") + str(time.time()) + " epoch"
out TerminX.green("[STATUS OK] All microservices operational")
