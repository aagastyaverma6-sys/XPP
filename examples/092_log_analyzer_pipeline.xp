RNM = XCOM
use re
use collections

logs = [
  "192.168.1.1 GET /index.html 200",
  "192.168.1.2 GET /login.html 200",
  "192.168.1.3 POST /api/auth 401",
  "192.168.1.4 GET /missing.html 404",
  "192.168.1.5 GET /dashboard 200"
]

status_codes = []
loop line in logs:
  m = re.findall("\b[1-5][0-9]{2}\b", line)
  if len(m) > 0:
    push m[0] to status_codes
  end
end

counter = collections.Counter(status_codes)
out "=== Log Analysis Summary ==="
out "Total Requests:", len(logs)
out "Status Distribution:", counter
